   RowBox[{
    RowBox[{"ClearAll", "[", "extractVocalFeatures", "]"}], ";"}], 
   RowBox[{
   "(*", "\:4e4b\:524d\:591a\:6b21\:8fd0\:884c\:8fc7\:5148clean", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"extractVocalFeatures", "[", "audioPath_String", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "afRaw", ",", "sr", ",", "af", ",", "data", ",", "frameSize", ",", 
         "hopSize", ",", "frames", ",", "energy", ",", "threshold", ",", 
         "centroid", ",", "mfcc", ",", "loudness", ",", "speechRate"}], "}"}],
        ",", 
       RowBox[{"Quiet", "@", 
        RowBox[{"Check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"afRaw", "=", 
            RowBox[{"Import", "[", 
             RowBox[{"audioPath", ",", "\"\<Audio\>\""}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"sr", "=", 
            RowBox[{"QuantityMagnitude", "[", 
             RowBox[{"AudioSampleRate", "[", "afRaw", "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"af", "=", 
            RowBox[{"Audio", "[", 
             RowBox[{
              RowBox[{"AudioData", "[", "afRaw", "]"}], ",", 
              RowBox[{"\"\<SampleRate\>\"", "->", "sr"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", "\:97f3\:8272\:4eae\:5ea6", "*)"}], 
           RowBox[{"centroid", "=", 
            RowBox[{"Mean", "[", 
             RowBox[{"Flatten", "[", 
              RowBox[{
               RowBox[{"AudioLocalMeasurements", "[", 
                RowBox[{"af", ",", "\"\<SpectralCentroid\>\""}], "]"}], 
               "[", "\"\<Values\>\"", "]"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", "\:97f3\:8272\:672c\:8d28", "*)"}], 
           RowBox[{"mfcc", "=", 
            RowBox[{"Mean", "[", 
             RowBox[{"Flatten", "[", 
              RowBox[{
               RowBox[{"AudioLocalMeasurements", "[", 
                RowBox[{"af", ",", "\"\<MFCC\>\""}], "]"}], 
               "[", "\"\<Values\>\"", "]"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", "\:54cd\:5ea6", "*)"}], 
           RowBox[{"loudness", "=", 
            RowBox[{"Replace", "[", 
             RowBox[{
              RowBox[{"AudioMeasurements", "[", 
               RowBox[{"af", ",", "\"\<Loudness\>\""}], "]"}], ",", 
              RowBox[{
               RowBox[{"Quantity", "[", 
                RowBox[{"m_", ",", "_"}], "]"}], ":>", "m"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", "\:53d1\:58f0\:5bc6\:5ea6", "*)"}], 
           RowBox[{"data", "=", 
            RowBox[{"Flatten", "[", 
             RowBox[{"AudioData", "[", "af", "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"frameSize", "=", 
            RowBox[{"Max", "[", 
             RowBox[{"1", ",", 
              RowBox[{"Round", "[", 
               RowBox[{"sr", "*", "0.02"}], "]"}]}], "]"}]}], ";", 
           RowBox[{"(*", 
            RowBox[{"20", "ms", " ", "\:5e27"}], "*)"}], 
           RowBox[{"hopSize", "=", 
            RowBox[{"Max", "[", 
             RowBox[{"1", ",", 
              RowBox[{"Round", "[", 
               RowBox[{"sr", "*", "0.01"}], "]"}]}], "]"}]}], ";", 
           RowBox[{"(*", 
            RowBox[{"10", "ms", " ", "\:6b65\:957f"}], "*)"}], 
           RowBox[{"frames", "=", 
            RowBox[{"Partition", "[", 
             RowBox[{
             "data", ",", "frameSize", ",", "hopSize", ",", "1", ",", "0."}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"energy", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"Mean", "[", 
               RowBox[{
                RowBox[{"Abs", "[", "#", "]"}], "^", "2"}], "]"}], "&"}], "/@",
              "frames"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"threshold", "=", 
            RowBox[{"Quantile", "[", 
             RowBox[{"energy", ",", "0.8"}], "]"}]}], ";", 
           RowBox[{
           "(*", "\:9608\:503c\:8fd9\:4e2a\:90e8\:5206\:662f\:5343\:95ee\:63d0\
\:7684\:5efa\:8bae", "*)"}], 
           RowBox[{"speechRate", "=", 
            RowBox[{"Mean", "[", 
             RowBox[{"UnitStep", "[", 
              RowBox[{"energy", "-", "threshold"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<SpectralCentroid\>\"", "->", 
              RowBox[{"N", "[", "centroid", "]"}]}], ",", 
             RowBox[{"\"\<MFCC\>\"", "->", 
              RowBox[{"N", "[", "mfcc", "]"}]}], ",", 
             RowBox[{"\"\<Loudness\>\"", "->", 
              RowBox[{"N", "[", "loudness", "]"}]}], ",", 
             RowBox[{"\"\<SpeechRate\>\"", "->", 
              RowBox[{"N", "[", "speechRate", "]"}]}]}], "|>"}]}], ",", 
          RowBox[{"(*", 
           RowBox[{"\:82e5\:5931\:8d25", "\:ff0c", 
            RowBox[{"\:8fd4\:56de", " ", "Missing"}]}], "*)"}], 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<SpectralCentroid\>\"", "->", 
             RowBox[{"Missing", "[", "\"\<NotFound\>\"", "]"}]}], ",", 
            RowBox[{"\"\<MFCC\>\"", "->", 
             RowBox[{"Missing", "[", "\"\<NotFound\>\"", "]"}]}], ",", 
            RowBox[{"\"\<Loudness\>\"", "->", 
             RowBox[{"Missing", "[", "\"\<NotFound\>\"", "]"}]}], ",", 
            RowBox[{"\"\<SpeechRate\>\"", "->", 
             RowBox[{"Missing", "[", "\"\<NotFound\>\"", "]"}]}]}], "|>"}]}], 
         "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "\:5904\:7406\:6240\:6709\:6b4c\:66f2", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"baseDir", "=", "\"\<C:\\\\wwc\\\\muxin_songs\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{"results", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"id", "=", 
        RowBox[{"song", "[", "\"\<ID\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"path", "=", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"baseDir", ",", 
           RowBox[{"ToString", "[", "id", "]"}], ",", "\"\<vocals.wav\>\""}], 
          "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"FileExistsQ", "[", "path", "]"}], ",", 
         RowBox[{
          RowBox[{"features", "=", 
           RowBox[{"extractVocalFeatures", "[", "path", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"merged", "=", 
           RowBox[{"Join", "[", 
            RowBox[{"song", ",", "features"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"results", ",", "merged"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<\:5df2\:5904\:7406: \>\"", ",", 
            RowBox[{"song", "[", "\"\<Title\>\"", "]"}]}], "]"}], ";"}], ",", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<\:7f3a\:5931\:6587\:4ef6: ID=\>\"", ",", "id"}], 
          "]"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"song", ",", "songInfo"}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"\:8f6c\:6362\:4e3a", " ", "Dataset"}], "\:ff1a", 
