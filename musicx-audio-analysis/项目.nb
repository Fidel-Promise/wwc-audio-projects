          ",", "\"\<\:64ad\:653e\:91cf\>\""}], "}"}]}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<\:64ad\:653e\:91cf Top 5\>\""}], ",", 
       RowBox[{"ImageSize", "->", "Large"}], ",", 
       RowBox[{"ChartStyle", "->", "\"\<Pastel\>\""}], ",", 
       RowBox[{"LabelingFunction", "->", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Placed", "[", 
           RowBox[{
            RowBox[{"NumberForm", "[", 
             RowBox[{"#", ",", 
              RowBox[{"DigitBlock", "->", "3"}]}], "]"}], ",", "Above"}], 
           "]"}], "&"}], ")"}]}], ",", 
       RowBox[{"ScalingFunctions", "->", "\"\<Log\>\""}]}], "]"}]}], ";"}], 
