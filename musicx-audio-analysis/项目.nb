         RowBox[{"#Plays", "&"}], ",", "5"}], "]"}], "]"}], "//", 
      "Normal"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"top5Titles", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"StringTake", "[", 
        RowBox[{"#", ",", 
         RowBox[{"Min", "[", 
          RowBox[{"20", ",", 
           RowBox[{"StringLength", "[", "#", "]"}]}], "]"}]}], "]"}], "&"}], "/@", 
      RowBox[{"(", 
       RowBox[{"top5Data", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "\"\<Title\>\""}], "]"}], "]"}], ")"}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"top5Plays", "=", 
     RowBox[{"top5Data", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "\"\<Plays\>\""}], "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"barChartTop5", "=", 
     RowBox[{"BarChart", "[", 
      RowBox[{"top5Plays", ",", 
       RowBox[{"ChartLabels", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{"top5Titles", ",", "Axis"}], "]"}]}], ",", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
